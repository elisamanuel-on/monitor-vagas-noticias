# Copia este ficheiro para ".env" (que fica de fora do git, ver .gitignore)
# e preenche com os teus valores reais. Nunca commits o ficheiro ".env".

# Connection string do MongoDB Atlas (Database -> Connect -> Drivers -> Python)
MONGODB_URI=mongodb+srv://utilizador:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Nome da base de dados a usar dentro do cluster (podes deixar este valor)
MONGODB_DB=monitor_vagas_noticias

# API key gratuita da ITJobs (pedida em https://www.itjobs.pt/api, só com o email)
ITJOBS_API_KEY=

# Termos de pesquisa para as vagas, separados por vírgula
VAGAS_QUERY=python,fastapi,programador web,análise de dados

# Localizações a filtrar (opcional, vazio = todas). Ver IDs em /api/docs/location da ITJobs
VAGAS_LOCATION_IDS=

# Termos de pesquisa para as notícias do setor, separados por " OR "
NOTICIAS_QUERY=tecnologia interativa OR "digital signage" OR "ecrãs interativos" OR "mesas multitoque"
